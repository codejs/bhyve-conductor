{
  "name": "bhyve-conductor",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "clean": "rm -rf dist",
    "bhyve:devices": "tsx src/scripts/bhyve-devices.ts",
    "bhyve:watch": "tsx src/scripts/bhyve-watch.ts",
    "bhyve:cmd": "tsx src/scripts/bhyve-cmd.ts",
    "tuya:devices": "tsx src/scripts/tuya-devices.ts",
    "sensors:read": "tsx src/scripts/sensors-read.ts",
    "weather:forecast": "tsx src/scripts/weather-forecast.ts",
    "audit": "tsx src/scripts/audit.ts",
    "audit:summary": "tsx src/scripts/audit.ts --summary",
    "audit:recovery": "tsx src/scripts/audit.ts --recovery",
    "notify:test": "tsx src/scripts/notify-test.ts",
    "simulate": "tsx src/scripts/simulate.ts",
    "conductor:check": "tsx src/index.ts --once --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "archive": "rm -f bhyve-conductor.zip && zip -rq bhyve-conductor.zip . -x '.git/*' '*/.git/*' '.idea/*' '*/.idea/*' 'node_modules/*' '*/node_modules/*' '.env' '*/.env' 'bhyve-conductor.zip'"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@10.9.4",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10.9.4",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild": true
  }
}
