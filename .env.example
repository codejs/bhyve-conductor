# Copy to .env and fill in. .env is git-ignored.

# --- Orbit B-hyve (same login as the B-hyve mobile app) ---
BHYVE_EMAIL=you@example.com
BHYVE_PASSWORD=change-me

# --- Tuya IoT Platform (https://platform.tuya.com) ---
# Cloud > Development > your project > Overview: "Access ID/Client ID" and "Access Secret/Client Secret"
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# Must match the data center your project uses:
#   https://openapi.tuyaus.com  (Western America)
#   https://openapi-ueaz.tuyaus.com (Eastern America)
#   https://openapi.tuyaeu.com  (Central Europe)
#   https://openapi.tuyacn.com  (China)
#   https://openapi.tuyain.com  (India)
TUYA_BASE_URL=https://openapi.tuyaus.com

# --- Sensors ---
# Comma-separated Tuya device IDs of the soil sensors (find them with `pnpm tuya:devices`)
TUYA_SOIL_SENSOR_IDS=
# Data-point code that holds soil moisture % (usually "humidity"; check `pnpm tuya:devices`)
TUYA_MOISTURE_CODE=humidity

LOG_LEVEL=info
